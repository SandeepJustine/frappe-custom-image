# Copy to .env (or set these as Coolify "Environment Variables" for the
# service) and fill in real values. Never commit a real .env file.

# --- Image ---
# Published by .github/workflows/build-and-push.yml
CUSTOM_IMAGE=ghcr.io/sandeepjustine/erpnext-custom
# Pin to a specific build in production, e.g. build-2026.08.01-abc1234
CUSTOM_TAG=latest

# --- Database ---
DB_ROOT_PASSWORD=change-me-to-a-strong-random-password

# --- Site ---
# Must match the site you create with `bench new-site` inside the
# backend container (see COOLIFY_DEPLOYMENT.md).
SITE_NAME=erp.example.com
